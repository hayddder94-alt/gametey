<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<title>دفتر <%= f.file_no || '#' + f.id %> | <%= settings.COMPANY_NAME %></title>
<style>
  body { font-family: 'Tajawal', Tahoma, sans-serif; color: #111; padding: 24px; }
  .sheet { max-width: 760px; margin: auto; border: 2px solid #0d2b45; border-radius: 10px; padding: 22px; }
  header { display: flex; justify-content: space-between; border-bottom: 3px solid #e0a526; padding-bottom: 10px; }
  h1 { font-size: 18px; margin: 0; }
  table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 13px; }
  th, td { border: 1px solid #999; padding: 7px 9px; text-align: right; }
  th { background: #f0f3f7; }
  .muted { color: #555; font-size: 12px; }
  .sig { display: flex; justify-content: space-between; margin-top: 44px; font-size: 13px; }
  .sig div { border-top: 1px dashed #555; width: 200px; text-align: center; padding-top: 6px; }
  @media print { .no-print { display: none; } body { padding: 0; } }
</style>
</head>
<body>
<div class="sheet">
  <header>
    <div>
      <h1><%= settings.COMPANY_NAME %></h1>
      <div class="muted"><%= settings.COMPANY_ADDRESS %> — <span dir="ltr"><%= settings.COMPANY_PHONE %></span></div>
    </div>
    <div>
      <b>دفتر تقسيط رقم: <%= f.file_no || 'بانتظار التفعيل' %></b><br>
      <span class="muted">الطلب: <%= f.order_number %></span>
    </div>
  </header>

  <table>
    <tr><th>الزبون</th><td><%= f.customer_name %></td><th>الهاتف</th><td dir="ltr"><%= f.customer_phone %></td></tr>
    <tr><th>الصفة</th><td><%= f.employment_type === 'GUARANTOR' ? 'بكفيل موظف' : 'موظف' %></td><th>المصرف</th><td><%= f.bank === 'RAFIDAIN' ? 'الرافدين' : f.bank === 'AHLI' ? 'الأهلي العراقي' : f.bank === 'TPI' ? 'TPI' : '—' %></td></tr>
    <tr><th>جهة العمل</th><td><%= f.employer || '—' %></td><th>الكفيل</th><td><%= f.guarantor_name || '—' %></td></tr>
    <tr><th>كتاب الاستمرارية</th><td colspan="3"><%= f.letter_ref || 'يُسلَّم في المعرض' %> — <%= f.letter_status === 'RECEIVED' ? 'مستلم ✔' : 'بانتظار التسليم' %></td></tr>
  </table>

  <table>
    <thead><tr><th>#</th><th>تاريخ الاستحقاق</th><th>المبلغ</th><th>تاريخ التسديد</th><th>المبلغ المسدد</th><th>توقيع المستلم</th></tr></thead>
    <tbody>
      <% payments.forEach(function(p){ %>
        <tr>
          <td><%= p.installment_no %></td>
          <td><%= p.due_date %></td>
          <td><%= formatIQD(p.amount) %></td>
          <td><%= p.paid_at || '' %></td>
          <td><%= p.paid_at ? formatIQD(p.paid_amount) : '' %></td>
          <td></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <p class="muted" style="margin-top:10px">يُحضَر الدفتر عند كل تسديد شهري. إجمالي الالتزام: <%= formatIQD(f.grand_total) %>.</p>
  <div class="sig"><div>توقيع الزبون</div><div>توقيع مسؤول الشركة</div></div>
</div>
<p class="no-print" style="text-align:center"><button onclick="window.print()">🖨️ طباعة الدفتر</button></p>
<script nonce="<%= cspNonce %>">document.querySelector('.no-print button').addEventListener('click', function(){ window.print(); });</script>
</body>
</html>
