<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main-content">
<div class="page-head">
  <div class="container">
    <h1>تتبع طلبك</h1>
    <p>أدخل رقم هاتفك الذي طلبت به وسنعرض لك حالة طلباتك — بدون حساب وبدون كلمة مرور</p>
  </div>
</div>

<div class="container section">
  <div class="form-card" style="max-width:560px;margin:0 auto">
    <div class="field">
      <label>رقم الهاتف الذي استخدمته في الطلب</label>
      <input type="tel" id="trackPhone" dir="ltr" placeholder="07XXXXXXXXX" inputmode="tel" maxlength="15">
    </div>
    <button type="button" class="btn btn-navy btn-block btn-lg" id="trackBtn"><%- icon('search') %> عرض حالة طلباتي</button>
    <p class="hint text-center mt-1">تُعرض آخر 10 طلبات مرتبطة بالرقم.</p>
  </div>

  <div id="trackResults" style="max-width:760px;margin:24px auto 0"></div>
</div>

<script>window.WA_NUMBER = "<%= settings.WHATSAPP_COMPANY_NUMBER %>";</script>
<script src="/js/vendor/dompurify.min.js"></script>
<script src="/js/track.js"></script>
</main>
<%- include('partials/footer') %>
