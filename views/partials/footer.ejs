<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <h4><%= settings.COMPANY_NAME %></h4>
        <p style="font-size:.92rem;margin:0 0 10px"><%= settings.COMPANY_SLOGAN %></p>
        <p style="font-size:.88rem;margin:0">كل ما يحتاجه بيتك من كهربائيات وأثاث ومنزلية، نقدًا أو بالتقسيط المريح بدون تعقيد.</p>
      </div>
      <div>
        <h4>روابط سريعة</h4>
        <ul>
          <li><a href="/">الرئيسية</a></li>
          <li><a href="/products">المنتجات</a></li>
          <li><a href="/products?offers=1">العروض</a></li>
          <li><a href="/about">نبذة عن الشركة</a></li>
          <li><a href="/track">تتبع طلبك</a></li>
          <li><a href="/contact">تواصل معنا</a></li>
          <li><a href="/cart">سلة التسوق</a></li>
        </ul>
      </div>
      <div>
        <h4>التصنيفات</h4>
        <ul>
          <% navCategories.slice(0, 6).forEach(function(c){ %>
            <li><a href="/products?category=<%= encodeURIComponent(c.slug) %>"><%= c.name %></a></li>
          <% }) %>
        </ul>
      </div>
      <div>
        <h4>معلومات التواصل</h4>
        <ul>
          <li><%- icon('pin') %> <%= settings.COMPANY_ADDRESS %></li>
          <li><%- icon('phone') %> <a href="tel:<%= settings.COMPANY_PHONE %>"><%= settings.COMPANY_PHONE %></a></li>
          <li><%- icon('whatsapp') %> <a href="https://wa.me/<%= settings.WHATSAPP_COMPANY_NUMBER %>" target="_blank" rel="noopener">تواصل عبر واتساب</a></li>
          <li><%- icon('card') %> الدفع: نقدًا أو بالتقسيط</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      © <%= year %> <%= settings.COMPANY_NAME %> — جميع الحقوق محفوظة
    </div>
  </div>
</footer>

<a class="wa-float" href="https://wa.me/<%= settings.WHATSAPP_COMPANY_NUMBER %>?text=<%= encodeURIComponent('السلام عليكم، لدي استفسار عن منتجاتكم في متجر ' + settings.COMPANY_NAME) %>" target="_blank" rel="noopener" aria-label="تواصل عبر واتساب" title="تواصل عبر واتساب">
